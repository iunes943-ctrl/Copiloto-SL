{
  "name": "worker-autolac",
  "private": true,
  "version": "0.1.0",
  "description": "Worker de leitura do SQL Server do AutoLac (só leitura) que envia retratos de fichas ao Copiloto São Luiz (Skip).",
  "engines": { "node": "20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "mssql": "^12.7.10"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}